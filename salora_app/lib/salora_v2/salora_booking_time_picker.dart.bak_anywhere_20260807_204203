import 'package:flutter/material.dart';

import 'salora_booking_v2_api.dart';

class SaloraBookingTimePicker extends StatefulWidget {
  const SaloraBookingTimePicker({
    super.key,
    required this.venueId,
    required this.api,
    required this.onQuoteChanged,
    this.initialDate,
    this.initialStartAt,
    this.initialEndAt,
    this.firstDate,
    this.minimumStartAt,
    this.excludeBookingId,
  });

  final int venueId;
  final SaloraBookingV2Api api;
  final ValueChanged<Map<String, dynamic>?> onQuoteChanged;
  final DateTime? initialDate;
  final DateTime? initialStartAt;
  final DateTime? initialEndAt;
  final DateTime? firstDate;
  final DateTime? minimumStartAt;
  final int? excludeBookingId;

  @override
  State<SaloraBookingTimePicker> createState() =>
      _SaloraBookingTimePickerState();
}

class _SaloraBookingTimePickerState extends State<SaloraBookingTimePicker> {
  late DateTime selectedDate;
  List<Map<String, dynamic>> starts = [];
  List<Map<String, dynamic>> ends = [];
  Map<String, dynamic> schedule = const {};
  String? selectedStartAt;
  String? selectedEndAt;
  Map<String, dynamic>? quote;
  String? error;
  bool loading = false;

  @override
  void initState() {
    super.initState();
    final today = _day(DateTime.now());
    final earliest = widget.firstDate == null ? today : _day(widget.firstDate!);
    final requestedSource = widget.initialStartAt ?? widget.initialDate;
    final requested = requestedSource == null ? earliest : _day(requestedSource);
    selectedDate = requested.isBefore(earliest) ? earliest : requested;
    WidgetsBinding.instance.addPostFrameCallback((_) => _initializeSelection());
  }

  Future<void> _initializeSelection() async {
    await _loadStarts();
    if (!mounted) return;

    final initialStart = widget.initialStartAt;
    if (initialStart == null || _day(initialStart) != selectedDate) return;

    final startClock = _dateClock(initialStart);
    Map<String, dynamic>? startItem;
    for (final item in starts) {
      if (_clock(item['value']?.toString()) == startClock) {
        startItem = item;
        break;
      }
    }
    if (startItem == null || startItem['available'] != true) return;

    await _selectStart(startItem);
    if (!mounted) return;

    final initialEnd = widget.initialEndAt;
    if (initialEnd == null) return;
    final endClock = _dateClock(initialEnd);
    Map<String, dynamic>? endItem;
    for (final item in ends) {
      if (_clock(item['value']?.toString()) == endClock) {
        endItem = item;
        break;
      }
    }
    if (endItem != null && endItem['available'] == true) {
      _selectEnd(endItem);
    }
  }

  Future<void> _pickDate() async {
    final now = DateTime.now();
    final today = _day(now);
    final earliest = widget.firstDate == null ? today : _day(widget.firstDate!);
    final initial = selectedDate.isBefore(earliest) ? earliest : selectedDate;
    final result = await showDatePicker(
      context: context,
      initialDate: initial,
      firstDate: earliest,
      lastDate: earliest.add(const Duration(days: 730)),
    );
    if (result == null) return;

    setState(() {
      selectedDate = result;
      selectedStartAt = null;
      selectedEndAt = null;
      starts = [];
      ends = [];
      schedule = const {};
      quote = null;
    });
    widget.onQuoteChanged(null);
    await _loadStarts();
  }

  Future<void> _loadStarts() async {
    setState(() {
      loading = true;
      error = null;
    });

    try {
      final debugQuery = _availabilityQuery();
      debugPrint('SALORA STARTS QUERY => $debugQuery');

      final rawResult = await widget.api.get(
        '/venues/${widget.venueId}/availability',
        query: debugQuery,
      );

      debugPrint('SALORA STARTS RAW => $rawResult');

      final result = _availabilityPayload(rawResult);

      debugPrint(
        'SALORA STARTS PARSED => '
        'schedule=${result['schedule']} | '
        'startsCount=${_mapList(result['starts']).length}',
      );

      if (!mounted) return;
      setState(() {
        starts = _applyMinimumStart(_mapList(result['starts']));
        schedule = result['schedule'] is Map
            ? Map<String, dynamic>.from(result['schedule'] as Map)
            : const {};

        if (!result.containsKey('starts') || !result.containsKey('schedule')) {
          error =
          'استجابة التوفر ناقصة. تم تحميل مسار غير صحيح أو نسخة قديمة من الباك.';
        }
      });
    } catch (exception) {
      if (!mounted) return;
      setState(() => error = exception.toString());
    } finally {
      if (mounted) setState(() => loading = false);
    }
  }

  Future<void> _selectStart(Map<String, dynamic> item) async {
    if (item['available'] != true) {
      _showReason(item['reason']?.toString() ?? 'هذا الوقت غير متاح.');
      return;
    }

    final value = item['value']?.toString();
    if (value == null || value.isEmpty) return;

    setState(() {
      selectedStartAt = value;
      selectedEndAt = null;
      ends = [];
      quote = null;
      loading = true;
      error = null;
    });
    widget.onQuoteChanged(null);

    try {
      final debugQuery = _availabilityQuery(startAt: value);
      debugPrint('SALORA ENDS QUERY => $debugQuery');

      final rawResult = await widget.api.get(
        '/venues/${widget.venueId}/availability',
        query: debugQuery,
      );

      debugPrint('SALORA ENDS RAW => $rawResult');

      final result = _availabilityPayload(rawResult);

      debugPrint(
        'SALORA ENDS PARSED => '
        'schedule=${result['schedule']} | '
        'endsCount=${_mapList(result['ends']).length}',
      );

      if (!mounted) return;
      setState(() {
        ends = _mapList(result['ends']);
        schedule = result['schedule'] is Map
            ? Map<String, dynamic>.from(result['schedule'] as Map)
            : schedule;

        if (!result.containsKey('ends')) {
          error =
          'لم يعُد الخادم بأوقات النهاية. تأكد من تشغيل مسار salora-v2 الحديث.';
        }
      });
    } catch (exception) {
      if (!mounted) return;
      setState(() => error = exception.toString());
    } finally {
      if (mounted) setState(() => loading = false);
    }
  }

  void _selectEnd(Map<String, dynamic> item) {
    if (item['available'] != true) {
      _showReason(item['reason']?.toString() ?? 'هذه النهاية غير متاحة.');
      return;
    }

    final value = item['value']?.toString();
    final itemQuote = item['quote'];
    if (value == null || itemQuote is! Map) return;

    setState(() {
      selectedEndAt = value;
      quote = Map<String, dynamic>.from(itemQuote);
    });

    widget.onQuoteChanged(<String, dynamic>{
      ...quote!,
      'selected_date': _apiDate(selectedDate),
      // The booking creation endpoint requires H:i, not an ISO timestamp.
      'selected_start': _clock(selectedStartAt),
      'selected_end': _clock(selectedEndAt),
    });
  }

  Map<String, String> _availabilityQuery({String? startAt}) => <String, String>{
    'date': _apiDate(selectedDate),
    if (startAt != null && startAt.isNotEmpty) 'start_at': startAt,
    if (widget.excludeBookingId != null)
      'booking_id': widget.excludeBookingId.toString(),
  };

  Map<String, dynamic> _availabilityPayload(Map<String, dynamic> response) {
    var current = response;

    for (var depth = 0; depth < 3; depth++) {
      if (current.containsKey('starts') ||
          current.containsKey('ends') ||
          current.containsKey('schedule')) {
        return current;
      }

      final nested = current['data'];
      if (nested is! Map) break;
      current = Map<String, dynamic>.from(nested);
    }

    return current;
  }

  List<Map<String, dynamic>> _applyMinimumStart(
      List<Map<String, dynamic>> items,
      ) {
    final minimum = widget.minimumStartAt;
    if (minimum == null) return items;

    return items.map((item) {
      final value = DateTime.tryParse(item['value']?.toString() ?? '');
      if (value == null || value.isAfter(minimum)) return item;
      return <String, dynamic>{
        ...item,
        'available': false,
        'status': 'unavailable',
        'reason': 'هذا الوقت ضمن آخر 120 ساعة ولا يمكن اختياره للتعديل.',
      };
    }).toList();
  }

  void _showReason(String message) {
    if (!mounted) return;
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(SnackBar(content: Text(message)));
  }

  @override
  Widget build(BuildContext context) {
    final colors = Theme.of(context).colorScheme;
    final isClosed = schedule['is_closed'] == true;
    final configured = schedule.isNotEmpty && schedule['configured'] != false;
    final scheduleMessage = schedule['message']?.toString().trim();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        OutlinedButton.icon(
          onPressed: loading ? null : _pickDate,
          icon: const Icon(Icons.calendar_month),
          label: Text('تاريخ المناسبة: ${_displayDate(selectedDate)}'),
        ),
        const SizedBox(height: 12),
        _scheduleCard(
          context,
          configured: configured,
          isClosed: isClosed,
          message: scheduleMessage,
        ),
        const SizedBox(height: 16),
        Row(
          children: [
            _legend(Icons.lock_clock_outlined, 'محجوز/غير متاح', colors.error),
            const SizedBox(width: 12),
            _legend(Icons.check_circle_outline, 'متاح', Colors.green),
            const Spacer(),
            const Text(
              'وقت البداية - على رأس الساعة',
              style: TextStyle(fontWeight: FontWeight.bold),
            ),
          ],
        ),
        const SizedBox(height: 8),
        if (loading) const LinearProgressIndicator(),
        if (error != null)
          Padding(
            padding: const EdgeInsets.symmetric(vertical: 10),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Text(
                  error!,
                  textAlign: TextAlign.right,
                  style: TextStyle(color: colors.error, height: 1.4),
                ),
                const SizedBox(height: 8),
                OutlinedButton.icon(
                  onPressed: loading ? null : _loadStarts,
                  icon: const Icon(Icons.refresh),
                  label: const Text('إعادة تحميل الأوقات'),
                ),
              ],
            ),
          ),
        if (!loading && isClosed)
          _emptyMessage('اليوم عطلة والصالة مغلقة. اختر تاريخاً آخر.'),
        if (!loading && error == null && !configured)
          _emptyMessage(
            scheduleMessage?.isNotEmpty == true
                ? scheduleMessage!
                : 'مالك الصالة لم يحدد ساعات العمل لهذا اليوم بعد.',
          ),
        if (!loading &&
            error == null &&
            configured &&
            !isClosed &&
            starts.isEmpty)
          _emptyMessage(
            scheduleMessage?.isNotEmpty == true
                ? scheduleMessage!
                : 'لا توجد أوقات بداية متاحة بهذا التاريخ.',
          ),
        if (starts.isNotEmpty)
          Wrap(
            alignment: WrapAlignment.end,
            spacing: 8,
            runSpacing: 8,
            children: starts.map((item) => _startChip(context, item)).toList(),
          ),
        if (selectedStartAt != null) ...[
          const SizedBox(height: 20),
          const Text(
            'وقت النهاية - بخطوات نصف ساعة',
            textAlign: TextAlign.right,
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 4),
          Text(
            'تظهر الخيارات حسب الحد الأدنى والحد الأقصى للحجز وساعات عمل الصالة.',
            textAlign: TextAlign.right,
            style: TextStyle(
              color: Theme.of(context).textTheme.bodySmall?.color,
              fontSize: 12,
            ),
          ),
          const SizedBox(height: 8),
          if (!loading && ends.isEmpty)
            _emptyMessage('لا توجد نهاية متاحة لوقت البداية المختار.'),
          Wrap(
            alignment: WrapAlignment.end,
            spacing: 8,
            runSpacing: 8,
            children: ends.map((item) => _endChip(context, item)).toList(),
          ),
        ],
        if (quote != null) ...[
          const SizedBox(height: 20),
          Card(
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  _row('المدة', _duration(quote!['duration_minutes'])),
                  _row(
                    'سعر الساعة',
                    '${_money(quote!['hourly_price_syp'])} ل.س',
                  ),
                  _row(
                    'السعر قبل العرض',
                    '${_money(quote!['price_before_discount_syp'])} ل.س',
                  ),
                  if ((quote!['discount_syp'] as num? ?? 0) > 0)
                    _row(
                      'خصم العرض',
                      '- ${_money(quote!['discount_syp'])} ل.س',
                    ),
                  const Divider(),
                  _row(
                    'إجمالي الصالة',
                    '${_money(quote!['final_price_syp'])} ل.س',
                    bold: true,
                  ),
                  if (quote!['offer'] is Map)
                    Padding(
                      padding: const EdgeInsets.only(top: 8),
                      child: Text(
                        'العرض المطبق: ${(quote!['offer'] as Map)['title']}',
                        textAlign: TextAlign.right,
                      ),
                    ),
                ],
              ),
            ),
          ),
        ],
      ],
    );
  }

  Widget _scheduleCard(
      BuildContext context, {
        required bool configured,
        required bool isClosed,
        required String? message,
      }) {
    final color = !configured
        ? Colors.orange
        : isClosed
        ? Theme.of(context).colorScheme.error
        : Colors.green;
    final icon = !configured
        ? Icons.schedule_outlined
        : isClosed
        ? Icons.event_busy_outlined
        : Icons.access_time_rounded;
    final text = message?.isNotEmpty == true
        ? message!
        : !configured
        ? 'ساعات العمل غير محددة.'
        : isClosed
        ? 'اليوم عطلة والصالة مغلقة.'
        : 'تم تحميل ساعات عمل الصالة لهذا اليوم.';

    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: color.withValues(alpha: .09),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: color.withValues(alpha: .35)),
      ),
      child: Row(
        children: [
          Icon(icon, color: color),
          const SizedBox(width: 8),
          Expanded(
            child: Text(
              text,
              textAlign: TextAlign.right,
              style: TextStyle(color: color, fontWeight: FontWeight.w700),
            ),
          ),
        ],
      ),
    );
  }

  Widget _startChip(BuildContext context, Map<String, dynamic> item) {
    final available = item['available'] == true;
    final value = item['value']?.toString() ?? '';
    final label = item['label']?.toString() ?? _clock(value);
    final color = available
        ? Colors.green
        : Theme.of(context).colorScheme.error;

    return ChoiceChip(
      avatar: Icon(
        available ? Icons.check_circle_outline : Icons.lock_clock_outlined,
        size: 17,
        color: color,
      ),
      label: Text(label),
      selected: selectedStartAt == value,
      selectedColor: Theme.of(context).colorScheme.primaryContainer,
      backgroundColor: color.withValues(alpha: .07),
      side: BorderSide(color: color.withValues(alpha: .55)),
      onSelected: (_) => _selectStart(item),
    );
  }

  Widget _endChip(BuildContext context, Map<String, dynamic> item) {
    final available = item['available'] == true;
    final value = item['value']?.toString() ?? '';
    final label = item['label']?.toString() ?? _clock(value);
    final duration = _duration(item['duration_minutes']);
    final color = available
        ? Colors.green
        : Theme.of(context).colorScheme.error;

    return ChoiceChip(
      avatar: Icon(
        available ? Icons.check_circle_outline : Icons.lock_clock_outlined,
        size: 17,
        color: color,
      ),
      label: Text('$label ($duration)'),
      selected: selectedEndAt == value,
      selectedColor: Theme.of(context).colorScheme.primaryContainer,
      backgroundColor: color.withValues(alpha: .07),
      side: BorderSide(color: color.withValues(alpha: .55)),
      onSelected: (_) => _selectEnd(item),
    );
  }

  Widget _legend(IconData icon, String text, Color color) => Row(
    mainAxisSize: MainAxisSize.min,
    children: [
      Icon(icon, size: 15, color: color),
      const SizedBox(width: 3),
      Text(text, style: TextStyle(fontSize: 11, color: color)),
    ],
  );

  Widget _emptyMessage(String message) => Padding(
    padding: const EdgeInsets.symmetric(vertical: 14),
    child: Text(
      message,
      textAlign: TextAlign.center,
      style: const TextStyle(fontWeight: FontWeight.w700, height: 1.4),
    ),
  );

  Widget _row(String label, String value, {bool bold = false}) {
    final style = bold ? const TextStyle(fontWeight: FontWeight.bold) : null;
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 4),
      child: Row(
        children: [
          Text(value, style: style),
          const Spacer(),
          Text(label, style: style),
        ],
      ),
    );
  }

  static List<Map<String, dynamic>> _mapList(dynamic value) {
    if (value is! List) return [];
    return value
        .whereType<Map>()
        .map((item) => Map<String, dynamic>.from(item))
        .toList();
  }

  static DateTime _day(DateTime value) =>
      DateTime(value.year, value.month, value.day);

  // IMPORTANT:
  // API must ALWAYS receive yyyy-MM-dd.
  // UI can show dd-MM-yyyy.
  static String _apiDate(DateTime value) =>
      '${value.year.toString().padLeft(4, '0')}-'
      '${value.month.toString().padLeft(2, '0')}-'
      '${value.day.toString().padLeft(2, '0')}';

  static String _displayDate(DateTime value) =>
      '${value.day.toString().padLeft(2, '0')}-'
      '${value.month.toString().padLeft(2, '0')}-'
      '${value.year.toString().padLeft(4, '0')}';

  static String _clock(String? value) {
    final text = value?.trim() ?? '';
    // Extract the written clock directly from the ISO value. Parsing a value
    // with +03:00 may convert it to UTC and silently shift the chosen hour.
    final match = RegExp(r'(\d{1,2}):(\d{2})').firstMatch(text);
    if (match == null) return text;
    return '${match.group(1)!.padLeft(2, '0')}:${match.group(2)}';
  }

  static String _duration(dynamic minutesValue) {
    final minutes = (minutesValue as num?)?.toInt() ?? 0;
    final hours = minutes ~/ 60;
    final rest = minutes % 60;
    if (hours == 0) return '$rest دقيقة';
    if (rest == 0) return '$hours ساعة';
    return '$hours ساعة و$rest دقيقة';
  }

  static String _money(dynamic value) {
    final number = (value as num?)?.round() ?? 0;
    return number.toString().replaceAllMapped(
      RegExp(r'\B(?=(\d{3})+(?!\d))'),
          (_) => ',',
    );
  }
}

