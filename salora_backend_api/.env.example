APP_NAME=Salora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Damascus
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salora_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Payment proofs are stored privately. Public venue/service images use the public disk explicitly.
FILESYSTEM_DISK=local
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173

# Academic/demo fallback only. The database setting exchange_rate_usd_to_syp takes precedence.
USD_TO_SYP=14000
PLATFORM_COMMISSION_PERCENT=0

# Transactional email / OTP. Gmail SMTP works without buying a domain.
# Use a dedicated Gmail account, enable Google 2-Step Verification, then create an App Password.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=localhost

# Never expose OTP codes in API responses outside controlled local testing.
OTP_EXPOSE_IN_LOCAL=false
# Firebase Cloud Messaging HTTP v1
FIREBASE_CREDENTIALS=storage/app/firebase/salora-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_CHANNEL_ID=salora_high_importance
# Salora booking protection
SALORA_BOOKING_PREPARATION_MINUTES=30
SALORA_BOOKING_HOLD_MINUTES=15
SALORA_BOOKING_LOCK_SECONDS=120
